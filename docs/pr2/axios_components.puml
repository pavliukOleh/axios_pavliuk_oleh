@startuml axios_components
' Діаграма компонентів lib/ бібліотеки axios (коміт 326843a), ПР2, варіант 9
' Дані: madge 8.0 / dependency-cruiser 16.10 (72 модулі, 177 залежностей), згруповано в 14 компонентів
' Число на стрілці — кількість імпортів між модулями компонентів; червоні стрілки — двонапрямні зв'язки
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 12
skinparam componentStyle rectangle
skinparam shadowing false
skinparam ArrowColor #555555
skinparam packageBackgroundColor #FAFAFA
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 90
top to bottom direction

package "Вхідна точка" {
  component "Entry\nlib/axios.js" as Entry
}
package "Ядро: lib/core, cancel, defaults" {
  component "Axios + InterceptorManager\nmergeConfig, buildFullPath\n(core/, 6 модулів)" as AxiosCore
  component "dispatchRequest\ntransformData, settle\n(core/, 5 модулів)" as dispatch
  component "AxiosHeaders\n(Ca = 10)" as AxiosHeaders #E3F2FD;line:1565C0
  component "AxiosError\n(Ca = 18)" as AxiosError #E3F2FD;line:1565C0
  component "cancel/\n(3 модулі)" as cancel
  component "defaults/\n(2 модулі)" as defaults
}
package "Транспорт: lib/adapters" {
  component "adapters.js\n(вибір адаптера)" as adapterSelector
  component "http.js\n1231 NLOC, max M = 106\nCe = 23 + 12 зовн." as http #FFE0B2;line:E65100;line.bold
  component "xhr.js\n291 NLOC, max M = 28" as xhr #FFF9C4;line:F9A825
  component "fetch.js\n583 NLOC, max M = 134" as fetch #FFE0B2;line:E65100;line.bold
}
package "Підтримка: helpers, utils, platform" {
  component "helpers/\n36 модулів\n(in 10 / out 7 компонентів)" as helpers #FFCDD2;line:C62828;line.bold
  component "utils.js\n1201 рядок, 63 експорти\n(Ca = 30)" as utils #FFCDD2;line:C62828;line.bold
  component "platform/ + env/\n(12 модулів)" as platform
}

