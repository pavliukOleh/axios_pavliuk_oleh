@startuml fragment_god_object_utils
' Фрагмент 1: God Object — вхідні залежності utils.js (Ca = 30 модулів з 71)
skinparam defaultFontName "DejaVu Sans"
skinparam componentStyle rectangle
skinparam shadowing false
left to right direction
package "Імпортують utils.js" {
  component "helpers/\n15 модулів" as h
  component "core/\n9 модулів" as c
  component "adapters/\n4 модулі" as a
  component "defaults/index.js" as d
  component "axios.js" as e
}
component "utils.js\n1201 рядок · 63 експорти\n34 функції перевірки типів is*()\n11 експортів не використовує ніхто\nмедіана: 3 функції на клієнта" as u #FFCDD2;line:C62828;line.bold
component "helpers/bind.js" as b
h --> u : 15
c --> u : 9
a --> u : 4
d --> u : 1
e --> u : 1
u -[#C62828,bold]-> b : цикл helpers ↔ utils
note bottom of u
  Ca = 30 при медіані Ca = 1 по 72 модулях
  Ca + Ce = 31 при медіані 3 (у 10 разів більше)
end note
@enduml

@startuml fragment_stovepipe_adapters
' Фрагмент 2: Stovepipe System — три адаптери без спільного шару
skinparam defaultFontName "DejaVu Sans"
skinparam componentStyle rectangle
skinparam shadowing false
component "adapters.js\n(вибір адаптера)" as sel
package "Ізольовані «труби» транспорту (жодних зв'язків між собою)" {
  component "http.js (Node.js)\nвласне формування URL\n(buildFullPath + buildURL)\nвласні auth, timeout,\ndecodeURIComponentSafe" as http #FFE0B2;line:E65100;line.bold
  component "xhr.js (браузер)\nвласне повідомлення\nпро таймаут" as xhr #FFF9C4;line:F9A825
  component "fetch.js (браузер)\nвласні auth,\ndecodeURIComponentSafe" as fetch #FFE0B2;line:E65100;line.bold
}
package "Частково спільне (helpers/)" {
  component "progressEventReducer\nsanitizeHeaderValue" as shared #C8E6C9
  component "resolveConfig\n(URL, auth, XSRF, FormData)" as rc
}
sel --> http
sel --> xhr
sel --> fetch
http --> shared
xhr --> shared
fetch --> shared
xhr --> rc
fetch --> rc
http .[#C62828].> rc : не використовує,\nдублює логіку
http .[#C62828].. fetch : клон decodeURIComponentSafe\nта витягування auth
http .[#C62828].. xhr : дублювання формування\nпомилки таймауту
@enduml

